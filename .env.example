# Super Vendedor — variables de entorno (copiar a .env)

ENV=development
INTERNAL_API_KEY=cambia_esto_en_produccion
MASTER_KEY=cambia_clave_admin_saas

DB_BACKEND=pocketbase
POCKETBASE_URL=http://178.105.48.103:8090
POCKETBASE_EMAIL=tu_admin@correo.com
POCKETBASE_PASSWORD=tu_password
VENTAS_COLLECTION=ventas
PLANES_CONFIG_COLLECTION=planes_config

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mem0 — memoria persistente del cliente (app/services/memory_service.py)
MEM0_STORAGE_DIR=app/storage_vault/mem0
MEM0_LLM_MODEL=gpt-4.1-mini
MEM0_EMBED_MODEL=text-embedding-3-small
MEM0_SEARCH_LIMIT=5

# OpenAI Media — Whisper / TTS / Visión (app/services/media_service.py)
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_MAX_TOKENS=1024
MEDIA_TEMP_DIR=app/storage_vault/media_temp
# TEST_VISION_IMAGE_URL=https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=500
# TEST_VISION_IMAGE_PATH=test_image.jpg

# Chat n8n — POST /api/v1/chat
CHAT_LLM_MODEL=gpt-4o-mini
CHAT_TENANT_ID=edwuar
CHAT_LEADS_COLLECTION=leads
CHAT_CONVERSATIONS_COLLECTION=conversations
CHAT_MESSAGES_COLLECTION=messages
CHAT_EXTRACTIONS_COLLECTION=media_extractions

# LLM Router híbrido (app/services/llm_router.py)
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_CLAUDE_MODEL=claude-3-5-sonnet-latest
LLM_COMPLEXITY_CHAR_THRESHOLD=180

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=super_vendedor

VAPI_WEBHOOK_SECRET=

OWNER_ID=edwuar
FOLLOWUP_SCHEDULER_ENABLED=true
MIN_HOURS_BETWEEN_FOLLOWUPS=24

# Meta Ads compliance LLM (Capa 3)
META_COMPLIANCE_MODEL=gpt-4.1
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
META_DEFAULT_DAILY_BUDGET=30000
META_DEFAULT_OBJECTIVE=OUTCOME_SALES
META_DEFAULT_LINK_URL=https://wa.me/573000000000
META_CAMPAIGN_COPY_MODEL=gpt-4.1
META_CREATIVE_FORMAT=image
META_USE_CATALOG_IMAGE=true
ADS_NOTIFY_WHATSAPP=

# Capa 5 — Orquestación (cron n8n → POST /ads/run-cycle)
ADS_AUTO_LAUNCH_ENABLED=true
ADS_MIN_PRIORITY_SCORE=70
ADS_MIN_PRIORIDAD=alta
ADS_HORAS_COOLDOWN_LANZAMIENTO=72
ADS_CYCLE_NOTIFY=true
ADS_TRENDS_LIMITE=10

# Capa 4 — Reglas de rentabilidad (COP)
ADS_UMBRAL_MINIMO_DATOS=15000
ADS_CPA_MAXIMO_ACEPTABLE=25000
ADS_ROAS_OBJETIVO=2.5
ADS_PORCENTAJE_ESCALADO=20
ADS_HORAS_MIN_ENTRE_ESCALADOS=24
ADS_HORAS_MIN_CAMPANA_NUEVA=48
ADS_LIMITE_DIARIO_CUENTA=200000
ADS_CPC_MAXIMO_ACEPTABLE=3000
ADS_CTR_MINIMO_ACEPTABLE=0.8
META_GEO_CITY_KEY=
META_GEO_REGION_KEY=
META_AD_LIBRARY_TOKEN=
META_TREND_KEYWORDS=
META_TRENDS_GEO=CO

# Avatares — ElevenLabs TTS + Replicate lip-sync (app/services/elevenlabs_service.py, replicate_service.py)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_TIMEOUT_SECONDS=120
REPLICATE_API_TOKEN=
REPLICATE_AVATAR_MODEL=wan-video/wan-2.2-s2v
REPLICATE_TIMEOUT_SECONDS=30
REPLICATE_POLL_INTERVAL_SECONDS=3
REPLICATE_MAX_WAIT_SECONDS=600
AVATAR_TEMP_DIR=app/storage_vault/avatar_temp
AVATAR_JOBS_COLLECTION=avatar_jobs
AVATAR_WEBHOOK_SECRET=
AVATAR_WEBHOOK_TIMEOUT_SECONDS=15

# Content & Outliers — SQLAlchemy (app/content/, app/services/content_remix_service.py)
CONTENT_DATABASE_URL=sqlite:///./app/storage_vault/content_outliers.db
# CONTENT_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/supervendedor
CONTENT_GEMINI_MODEL=gemini-2.0-flash
CONTENT_COMPOSITE_THRESHOLD=1.2
CONTENT_DEFAULT_LLM=openai
CONTENT_LLM_CACHE_TTL_SECONDS=86400
CONTENT_WEBHOOK_SECRET=
CONTENT_WEBHOOK_TIMEOUT_SECONDS=15
CONTENT_PIPELINE_COST_USD=0.02
