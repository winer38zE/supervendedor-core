{
  "name": "ED NET PRO — Avatar Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "avatar-finished",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-avatar-finished",
      "name": "Webhook Avatar Listo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "ednetpro-avatar-finished"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-completed",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-completed",
      "name": "¿Completado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-ok",
              "name": "mensaje",
              "value": "=🎬 Avatar listo (job {{ $json.body.job_id }})\n\nVideo: {{ $json.body.video_url }}\n\nAudio local: {{ $json.body.audio_path }}",
              "type": "string"
            },
            {
              "id": "video-url",
              "name": "video_url",
              "value": "={{ $json.body.video_url }}",
              "type": "string"
            },
            {
              "id": "job-id",
              "name": "job_id",
              "value": "={{ $json.body.job_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-success",
      "name": "Formatear éxito",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 180]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-fail",
              "name": "mensaje",
              "value": "=❌ Avatar falló (job {{ $json.body.job_id }})\n\nError: {{ $json.body.error }}",
              "type": "string"
            },
            {
              "id": "job-id-fail",
              "name": "job_id",
              "value": "={{ $json.body.job_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-failure",
      "name": "Formatear error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $env.ADS_NOTIFY_WHATSAPP || $env.OWNER_WHATSAPP }}\",\n  \"text\": \"{{ $json.mensaje }}\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "whatsapp-notify-success",
      "name": "WhatsApp (éxito)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 180],
      "disabled": true,
      "notes": "Activa este nodo y configura EVOLUTION_* + OWNER_WHATSAPP en n8n"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $env.ADS_NOTIFY_WHATSAPP || $env.OWNER_WHATSAPP }}\",\n  \"text\": \"{{ $json.mensaje }}\"\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "whatsapp-notify-failure",
      "name": "WhatsApp (error)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 420],
      "disabled": true,
      "notes": "Activa este nodo para alertas de fallo"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"received\": \"{{ $json.body.job_id }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-webhook",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Webhook Avatar Listo": {
      "main": [
        [
          {
            "node": "¿Completado?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Completado?": {
      "main": [
        [
          {
            "node": "Formatear éxito",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Formatear error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear éxito": {
      "main": [
        [
          {
            "node": "Responder 200",
            "type": "main",
            "index": 0
          },
          {
            "node": "WhatsApp (éxito)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear error": {
      "main": [
        [
          {
            "node": "Responder 200",
            "type": "main",
            "index": 0
          },
          {
            "node": "WhatsApp (error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "ED NET PRO"
    },
    {
      "name": "Avatares"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
