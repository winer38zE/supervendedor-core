{
  "name": "Supervendedor — Meta Ads Cycle",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Cada 4 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPERVENDEDOR_URL }}/ads/run-cycle",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"launch_new_campaign\": true,\n  \"evaluar_reglas\": true,\n  \"notificar_whatsapp\": true\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "http-run-cycle",
      "name": "POST /ads/run-cycle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CON_CREDENCIAL",
          "name": "Supervendedor X-API-Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-errors",
      "name": "¿Errores?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Cada 4 horas": {
      "main": [
        [
          {
            "node": "POST /ads/run-cycle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /ads/run-cycle": {
      "main": [
        [
          {
            "node": "¿Errores?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "meta": {
    "templateCredsSetupCompleted": false
  }
